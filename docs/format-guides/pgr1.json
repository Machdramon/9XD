  "status": "Native GOTHPOK/zlib decoding, textured P/T/V tracks and primary NRM/HRD/SFT vehicle LODs with vertex/texture companions",
  "stages": {
    "container": [
      "GOTHPOK payload begins at +20; decoded size UInt32 at +8; bit 0 of flags at +12 selects LZ vs stored.",
      "LZ uses 30 MSB-first token flags per little-endian control word; low two bits select distance bits (14-mode). Match UInt16 encodes distance=(token&mask)+1 and length=(token>>distanceBits)+3.",
      "Reject truncated tokens, out-of-history references, output overruns and trailing payload bytes."
    ],
    "vehicle": [
      "Resolve NRM, NRM_V and NRM_RES resource relationships."
    ],
    "track": [
      "Open original .DyP/.NtP with same-folder matching T/V companions. Compressed GOTHPOK and decoded on-disk P/T/V resources are accepted. RAM-only resources require the original disk files.",
      "Validate bounded 60-byte tree nodes, independently reset UInt16 strips, 24/28-byte external vertex declarations and material-to-texture directory IDs.",
      "Native track material candidates share a snapshot/decompression/texture cache. BC1/BC3 textures are assigned automatically and added to the 2D library when previewed.",
      "Unknown texture formats use magenta placeholders; invalid-UV triangles are explicitly omitted. Binary alpha, reconstructed normals and missing source vertex lighting are approximations. Additional scene sections remain pending."
    ]
  },
  "limitations": [
    "Do not reuse MSR Pak, alpha or PGR2 zlib rules.",
    "Signatures and sample hashes support analysis, not executable extraction."
  ],
